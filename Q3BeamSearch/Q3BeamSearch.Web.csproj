<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <StartupObject>Q3BeamSearch.WebMain</StartupObject>
  </PropertyGroup>

  <!-- References/ holds local engine sources (oDFe, Opensource Defrag) and reference files:
       not part of the web app, and too big to glob on every build. -->
  <ItemGroup>
    <Compile Remove="References\**" />
    <Content Remove="References\**" />
    <EmbeddedResource Remove="References\**" />
    <None Remove="References\**" />
  </ItemGroup>

</Project>
